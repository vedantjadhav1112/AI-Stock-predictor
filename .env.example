# ============================================================
# .env.example — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Only GEMINI_API_KEY is required for AI-powered analysis.
# All other keys are optional and enable additional data sources.
# ============================================================

# ==============================================================
# REQUIRED — AI Agent Reasoning
# ==============================================================

# Google Gemini API Key (powers all AI agent analysis)
# Get a FREE key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================
# OPTIONAL — Enhanced Data Sources
# ==============================================================

# Federal Reserve Economic Data (macroeconomic indicators)
# Get a FREE key at: https://fred.stlouisfed.org/docs/api/api_key.html
# Without this, macro data falls back to yfinance market indices.
# FRED_API_KEY=your_fred_api_key_here

# NewsAPI.org (enhanced news coverage from 80,000+ sources)
# Get a FREE key at: https://newsapi.org (100 requests/day)
# Without this, news comes from yfinance only.
# NEWS_API_KEY=your_news_api_key_here

# Alpha Vantage (additional financial data & technical indicators)
# Get a FREE key at: https://www.alphavantage.co/support/
# ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# ==============================================================
# OPTIONAL — LLM Configuration
# ==============================================================

# Which Gemini model to use (default: gemini-2.0-flash)
# Options: gemini-2.0-flash (fast, free tier), gemini-2.5-pro (powerful)
# LLM_MODEL=gemini-2.0-flash

# Temperature for LLM responses (0.0 = deterministic, 1.0 = creative)
# Lower is better for financial analysis (factual, precise)
# LLM_TEMPERATURE=0.3
