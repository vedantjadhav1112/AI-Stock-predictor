# ============================================================
# .env.example — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These are optional — the app works without them by using
# yfinance's built-in news and free data sources.
# ============================================================

# (Optional) News API key for enhanced news coverage
# Get one free at: https://newsapi.org
# NEWS_API_KEY=your_api_key_here

# (Optional) Alpha Vantage API key for additional data
# Get one free at: https://www.alphavantage.co/support/
# ALPHA_VANTAGE_KEY=your_api_key_here
