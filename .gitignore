# ============================================================
# .gitignore — Files that should NOT go to GitHub
# ============================================================

# Python virtual environment (huge, everyone installs their own)
venv/
.venv/

# Python bytecode (auto-generated, not needed in source control)
__pycache__/
*.py[cod]
*$py.class

# Trained model files (too large for Git, users retrain locally)
models/*.pkl
models/*.joblib

# Environment variables (contains API keys — NEVER commit these!)
.env

# IDE settings (personal preference, not part of the project)
.vscode/
.idea/

# AI tool settings (local config, not part of the project)
.claude/
.gemini/

# Dart/Flutter package cache (downloaded by pub get)
.pub-cache/

# OS files
.DS_Store
Thumbs.db

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Distribution / packaging
dist/
build/
*.egg-info/

# Flutter/Dart generated files
.pub-cache/
.dart_tool/
.flutter-plugins-dependencies
stock_predictor_app/.dart_tool/
stock_predictor_app/build/
stock_predictor_app/.flutter-plugins-dependencies
stock_predictor_app/*.iml
stock_predictor_app/android/.gradle/
stock_predictor_app/android/.kotlin/
stock_predictor_app/ios/Flutter/ephemeral/
